#!/bin/sh
#
# Runs as root BEFORE the new BHTerminal.app is written, so the reinstall
# replaces a LIVE app rather than leaving the old copy running.
#
# Matched by EXACT executable path, not by process name: `killall BHTerminal`
# would also kill a development build running from a checkout, which is not
# this installer's business.

# The executable is lowercase: Tauri names it after the crate, not the bundle.
PATTERN='^/Applications/BHTerminal\.app/Contents/MacOS/bhterminal( |$)'

/usr/bin/pkill -TERM -f "$PATTERN" 2>/dev/null || true

i=0
while [ "$i" -lt 5 ]; do
    /usr/bin/pgrep -f "$PATTERN" >/dev/null 2>&1 || exit 0
    /bin/sleep 1
    i=$((i + 1))
done

/usr/bin/pkill -KILL -f "$PATTERN" 2>/dev/null || true
exit 0
